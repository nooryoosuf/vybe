{
  "manifest_version": 3,
  "name": "VYBE — Netflix Social Watch Party Sync",
  "version": "1.0.0",
  "description": "Observes Netflix playback on netflix.com and synchronizes play, pause, and seek commands with your VYBE Watch Party room. Each viewer streams through their own Netflix account — protected content plays on the official Netflix site; no embedding or proxy.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.netflix.com/*",
    "https://vybe.nooryoosuf.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3100/*",
    "https://*.pages.dev/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VYBE Watch Party Sync",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content-netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vybe.nooryoosuf.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:3100/*",
        "https://*.pages.dev/*",
        "https://*.workers.dev/*"
      ],
      "js": ["content-vybe-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
