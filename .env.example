# ============================================================================
# VYBE — Social Watch Party Platform Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# ============================================================================

# 1. Supabase Configuration (Authentication, Postgres Database & Realtime)
# When provided, VYBE connects directly to your Supabase project for Auth,
# RLS-protected tables, Presence, and Broadcast channels.
# When omitted in local development, VYBE seamlessly activates its built-in
# Persistent Multi-Session Realtime Engine (.vybe-db.json + SSE + BroadcastChannel)
# so all real-time features work out-of-the-box across multiple browser windows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key (NEVER expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# 2. LiveKit WebRTC Configuration (Optional — for Cloud SFU Voice & Video)
# In addition to VYBE's built-in WebRTC Peer-to-Peer signaling and local media tracks,
# you can configure a LiveKit Cloud or self-hosted SFU server:
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 3. Tenor GIF API Key (Optional — for extended live GIF search in chat)
# VYBE includes a rich built-in cinema reaction GIF catalog out of the box.
NEXT_PUBLIC_TENOR_API_KEY=

# 4. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
