# ============================================================================
# VYBE — Netflix-Only Platform Environment Configuration
# Copy this file to .env.local and fill in your credentials.
# ============================================================================

# 1. Supabase Configuration (Authentication, Postgres Database & Realtime)
# When provided, VYBE connects directly to your Supabase project for Auth,
# RLS-protected tables, Presence, and Broadcast channels.
# When omitted in local development, VYBE seamlessly activates its built-in
# Persistent Multi-Session Realtime Engine (Server store + SSE + BroadcastChannel)
# so all real-time features work out-of-the-box across multiple browser windows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key (NEVER expose in NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=

# 2. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
